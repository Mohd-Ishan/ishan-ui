{
  "name": "ishan-ui",
  "version": "0.1.0",
  "description": "A production-grade, config-driven React component library. Zero hardcoded values, full TypeScript support, tree-shakeable ESM/CJS builds.",
  "type": "module",
  "license": "MIT",
  "author": "Ishan",
  "keywords": [
    "react",
    "react-component-library",
    "navbar",
    "ui-library",
    "typescript",
    "framer-motion",
    "design-system"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ishan/ishan-ui.git"
  },
  "bugs": {
    "url": "https://github.com/ishan/ishan-ui/issues"
  },
  "homepage": "https://github.com/ishan/ishan-ui#readme",

  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": [
    "**/*.css"
  ],

  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./navbar": {
      "types": "./dist/navbar.d.ts",
      "import": "./dist/navbar.js",
      "require": "./dist/navbar.cjs"
    },
    "./button": {
      "types": "./dist/button.d.ts",
      "import": "./dist/button.js",
      "require": "./dist/button.cjs"
    },
    "./modal": {
      "types": "./dist/modal.d.ts",
      "import": "./dist/modal.js",
      "require": "./dist/modal.cjs"
    },
    "./style.css": "./dist/style.css",
    "./package.json": "./package.json"
  },

  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],

  "engines": {
    "node": ">=18"
  },

  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0",
    "react-router": ">=6.4.0"
  },
  "peerDependenciesMeta": {
    "react-router": {
      "optional": true
    }
  },

  "dependencies": {
    "@emotion/is-prop-valid": "^1.3.1",
    "framer-motion": "^11.11.17"
  },

  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.0.1",
    "@testing-library/user-event": "^14.5.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^8.57.1",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^5.1.0",
    "jsdom": "^25.0.1",
    "prettier": "^3.4.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vite-plugin-dts": "^4.3.0",
    "vitest": "^2.1.8"
  },

  "scripts": {
    "dev": "vite build --watch",
    "build": "npm run typecheck && vite build && node scripts/verify-exports.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.build.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "lint:fix": "eslint \"src/**/*.{ts,tsx}\" --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css,md}\"",
    "verify-exports": "node scripts/verify-exports.mjs",
    "changeset": "changeset",
    "changeset:version": "changeset version",
    "release": "npm run build && changeset publish",
    "prepublishOnly": "npm run build"
  },

  "publishConfig": {
    "access": "public"
  }
}
